{
  "permissions": {
    "allow": [
      "Bash(./node_modules/.bin/tsc:*)",
      "Bash(./node_modules/.bin/vite build:*)",
      "Bash(bunx --bun tsc --noEmit -p packages/frontend/tsconfig.app.json 2>&1 | head -30)",
      "Bash(bunx --bun tsc --noEmit -p packages/frontend/tsconfig.json 2>&1 | head -30)",
      "Bash(bunx --bun tsc --noEmit -p packages/shared/tsconfig.json 2>&1 | head -10)",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__get_network_request"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  }
}
